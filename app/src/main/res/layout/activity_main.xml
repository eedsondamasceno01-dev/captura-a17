<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#111111">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="GRAVADOR DE TELA A17" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="24sp" android:gravity="center"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pré-visualização do que está sendo capturado"
            android:textColor="#BBBBBB" android:textSize="14sp"
            android:gravity="center" android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"/>

        <FrameLayout
            android:layout_width="match_parent" android:layout_height="420dp"
            android:background="#000000">

            <SurfaceView
                android:id="@+id/previewSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/previewHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="A prévia aparecerá aqui após iniciar"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="16sp"/>
        </FrameLayout>

        <Switch
            android:id="@+id/micSwitch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Usar microfone"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:checked="true"
            android:layout_marginTop="14dp"/>

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:text="● INICIAR GRAVAÇÃO"
            android:textSize="17sp" android:layout_marginTop="12dp"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">

            <Button
                android:id="@+id/pauseBtn"
                android:layout_width="0dp" android:layout_height="58dp"
                android:layout_weight="1" android:text="⏸ PAUSAR"
                android:enabled="false"/>

            <Button
                android:id="@+id/resumeBtn"
                android:layout_width="0dp" android:layout_height="58dp"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="▶ CONTINUAR" android:enabled="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:text="■ PARAR E SALVAR"
            android:textSize="17sp" android:layout_marginTop="10dp"
            android:enabled="false"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pronto para gravar."
            android:textColor="#FFFFFF" android:textSize="16sp"
            android:gravity="center" android:layout_marginTop="18dp"
            android:paddingBottom="24dp"/>
    </LinearLayout>
</ScrollView>
