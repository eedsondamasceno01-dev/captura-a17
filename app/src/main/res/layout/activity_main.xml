<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRAVADOR DE TELA A17"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prévia pequena do que está sendo gravado"
            android:textColor="#BBBBBB"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <!-- Pequena prévia da tela -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="#000000">

            <SurfaceView
                android:id="@+id/previewSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/previewHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="A prévia da gravação aparecerá aqui"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="14sp"/>
        </FrameLayout>

        <!-- Câmera opcional -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cameraCard"
            android:layout_width="140dp"
            android:layout_height="180dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"/>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/cameraBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="📷 LIGAR CÂMERA"/>

            <Button
                android:id="@+id/switchCameraBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🔄 TROCAR"
                android:enabled="false"/>
        </LinearLayout>

        <Switch
            android:id="@+id/micSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usar microfone"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:checked="true"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="● INICIAR GRAVAÇÃO"
            android:textSize="17sp"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/pauseBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="⏸ PAUSAR"
                android:enabled="false"/>

            <Button
                android:id="@+id/resumeBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="▶ CONTINUAR"
                android:enabled="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="💾 PARAR E SALVAR"
            android:textSize="17sp"
            android:layout_marginTop="8dp"
            android:enabled="false"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pronto para gravar."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:paddingBottom="20dp"/>
    </LinearLayout>
</ScrollView>
